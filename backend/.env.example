DATABASE_URL="postgresql://username:password@localhost:5432/matchflix"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
PORT=5001
NODE_ENV=development

# Supabase Configuration (Project Settings > API Keys). Backend only: never put the secret key in the frontend.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your-secret-key"

# Google sign-in: OAuth 2.0 "Web application" client ID from Google Cloud Console (APIs & Services > Credentials).
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
