# Copy this file to keystore.properties (same folder) and fill in your own values.
# keystore.properties and the .jks file are git-ignored: never commit them, and keep backups of
# both somewhere safe (e.g. a password manager). See README → "Releasing to Google Play".

# Path to your upload keystore, relative to this android/ folder
storeFile=upload-keystore.jks
storePassword=your-keystore-password
keyAlias=upload
keyPassword=your-key-password
